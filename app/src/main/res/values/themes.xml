<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.MyGarden" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your light theme here. -->
        <!-- <item name="colorPrimary">@color/my_light_primary</item> -->
        <item name="android:windowBackground">@color/beige</item>
        <item name="colorOnSurface">@color/dark_green</item>
        <item name="colorPrimary">@color/dark_orange</item>
        <item name="colorText">@color/black</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="waterColor">@color/light_blue</item>
    </style>

    <style name="Theme.MyGarden" parent="Base.Theme.MyGarden" />

    <style name="Theme.MyGarden.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <style name="Theme.MyGarden.AppBarOverlay" parent="ThemeOverlay.AppCompat.Dark.ActionBar" />

    <style name="Theme.MyGarden.PopupOverlay" parent="ThemeOverlay.AppCompat.Light" />
</resources>